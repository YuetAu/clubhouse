# PostgreSQL
DATABASE_URL=postgresql+asyncpg://clubhouse:clubhouse@postgres:5432/clubhouse

# Backend
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ANON_JWT_EXPIRE_MINUTES=1440

# OAuth providers — add/remove entries to enable providers.
# Well-known: google, github, discord (need only id + credentials).
# Custom OIDC: add "issuer_url" for auto-discovery, or "userinfo_url" explicitly.
# Example with a custom OIDC provider:
#   {"id":"keycloak","client_id":"...","client_secret":"...","issuer_url":"https://sso.example.com/realms/myrealm"}
OAUTH_PROVIDERS_JSON=[{"id":"google","client_id":"","client_secret":""},{"id":"github","client_id":"","client_secret":""},{"id":"discord","client_id":"","client_secret":""}]

# Frontend
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000
